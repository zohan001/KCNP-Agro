# ============================================
# Environment Variables
# ============================================

# Server configuration
PORT=3000
NODE_ENV=development

# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/verdant
# Atlas example:  mongodb+srv://<user>:<password>@cluster.mongodb.net/verdant
MONGO_URI=mongodb://127.0.0.1:27017/verdant

# CORS allowed origins (comma-separated, or * for all)
#
# SECURITY: in production, leave this EMPTY to allow same-origin only
# (recommended — the frontend is served by this same server). '*' is only
# honored in development. Set a specific origin only when the frontend is
# hosted elsewhere, e.g. https://app.example.com
CORS_ORIGIN=

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# JWT authentication
# SECURITY: the server refuses to start in production while this is empty or
# still the development default. Generate a strong value:
#   openssl rand -hex 32
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Name of the httpOnly session cookie that carries the JWT after login.
AUTH_COOKIE_NAME=kcnp_session

# Public URL of the application (used to build password reset links)
# In production set this to your real domain, e.g. https://verdant-agro.onrender.com
FRONTEND_URL=http://localhost:3000

# SMTP / email settings (used to deliver password reset emails)
# Leave SMTP_* empty to fall back to showing the reset link on screen.
# Gmail example: host=smtp.gmail.com, port=587, secure=false (enable 2FA app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KCNP Agro <no-reply@kcnpagro.org>

# M-Pesa (Safaricom Daraja) STK Push — get creds at https://developer.safaricom.co.ke
# Leave MPESA_* empty to keep the manual payment flow (pending + admin approval).
# Sandbox shortcode is 174379 with the test passkey from the Daraja portal.
# MPESA_CALLBACK_URL must be a public https URL, e.g. https://your-app.onrender.com/mpesa/callback
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=

# Paystack (Kenya M-Pesa via Charge API) — https://dashboard.paystack.com
# Leave PAYSTACK_SECRET_KEY empty to fall back to Daraja or manual approval.
# In the dashboard, enable Mobile Money in Preferences → Payment Channels,
# and set the webhook URL to https://your-app.onrender.com/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=KES

# Google reCAPTCHA v2 (checkbox) — protects auth + payment forms.
# Get a site + secret pair at https://www.google.com/recaptcha/admin
# Add your Render domain to the allowed list in Google's console.
# Leave RECAPTCHA_SECRET_KEY empty to disable verification (dev/staging).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
