# ============================================
# Environment Variables
# ============================================

# Server configuration
PORT=3000
NODE_ENV=development

# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/verdant
# Atlas example:  mongodb+srv://<user>:<password>@cluster.mongodb.net/verdant
MONGO_URI=mongodb://127.0.0.1:27017/verdant

# CORS allowed origins (comma-separated, or * for all)
CORS_ORIGIN=*

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# JWT authentication
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Public URL of the application (used to build password reset links)
# In production set this to your real domain, e.g. https://verdant-agro.onrender.com
FRONTEND_URL=http://localhost:3000

# SMTP / email settings (used to deliver password reset emails)
# Leave SMTP_* empty to fall back to showing the reset link on screen.
# Gmail example: host=smtp.gmail.com, port=587, secure=false (enable 2FA app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KCNP Agro <no-reply@kcnpagro.org>
